# Copy missing settings into your existing .env; never overwrite existing credentials.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Native PostgreSQL fields. Supply all five; no credentials have fallback values.
# Use localhost for host tools; Compose overrides the API host to its db service.
# Compose provisions DB_USER as a superuser for local development only.
# Passwords need no manual URL encoding. Do not put real secrets in this example.
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# Hosted workers may instead receive a PostgreSQL DATABASE_URL through runtime
# secret injection, with TLS and a restricted login. DB_* takes precedence.
# Local Compose ignores DATABASE_URL and never connects to the hosted database.
DATABASE_URL=
GCP_PROJECT_ID=

BAGEL_SYMBOLS=SPY,QQQ,IWM,VXUS
BAGEL_FEED=iex
# Dates mean America/New_York midnight; timestamps need an explicit offset.
# End is exclusive. Empty dates default to eligible now and the preceding 5 years.
BAGEL_HISTORY_START=
BAGEL_HISTORY_END=
BAGEL_MAX_HISTORY_YEARS=5
BAGEL_AUTO_BACKFILL=true
# Disable WebSocket collection to use periodic historical repair only.
BAGEL_STREAM_ENABLED=true
BAGEL_BACKFILL_WORKERS=4
# Decimal MB; leave headroom below the 500 MB Free limit for capacity recovery.
BAGEL_DATABASE_BUDGET_MB=450
BAGEL_WATCHLIST_POLL_SECONDS=30
BAGEL_HISTORICAL_DELAY_MINUTES=15
BAGEL_WINDOW_OPEN=04:00
BAGEL_WINDOW_CLOSE=20:00
BAGEL_RECONCILE_DAYS=7
BAGEL_HEALTH_PORT=9090

# Local Compose runs one unauthenticated, loopback-published API and its workers.
# Compose forces ingestion, automatic backfill and streaming off during the hold.
# Do not expose this local API or use its superuser configuration in production.
