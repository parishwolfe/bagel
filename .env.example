# Copy missing settings into your existing .env; never overwrite existing credentials.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Native PostgreSQL connection, not the Supabase REST API URL/key.
# Persistent hosted workers should use the Supabase session pooler (port 5432)
# when IPv4 is required. Require TLS and provision a login with bagel_ingester membership.
DATABASE_URL=
# Alternatively provide separate PostgreSQL connection fields. Reserved characters
# in passwords need no manual URL encoding; the driver builds a keyword connection string.
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=
SUPABASE_PASSWORD=
SUPABASE_SSLMODE=require
# Local owner connection used ONLY by the Compose migration helper; never give it to the worker.
MIGRATION_DATABASE_URL=

# Retained for future frontend/client use; not used by ingestion.
SUPABASE_URL=
SUPABASE_KEY=
GCP_PROJECT_ID=

BAGEL_SYMBOLS=SPY,QQQ,IWM,VXUS
BAGEL_FEED=iex
# Dates mean America/New_York midnight; timestamps need an explicit offset.
# End is exclusive. Empty dates default to eligible now and the preceding 5 years.
BAGEL_HISTORY_START=
BAGEL_HISTORY_END=
BAGEL_MAX_HISTORY_YEARS=5
BAGEL_AUTO_BACKFILL=true
BAGEL_BACKFILL_WORKERS=4
# Decimal MB; leave headroom below the 500 MB Free limit for capacity recovery.
BAGEL_DATABASE_BUDGET_MB=450
BAGEL_WATCHLIST_POLL_SECONDS=30
BAGEL_HISTORICAL_DELAY_MINUTES=15
BAGEL_WINDOW_OPEN=04:00
BAGEL_WINDOW_CLOSE=20:00
BAGEL_RECONCILE_DAYS=7
BAGEL_HEALTH_PORT=9090
