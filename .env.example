# Copy to .env and adjust as needed. Defaults match IB Gateway paper trading.
# .env is gitignored; never commit real credentials.

# --- IB Gateway (paper) connection ---
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1

# --- data / backtest ---
# CATALOG_PATH=/absolute/path/to/catalog   # default: <project>/data/catalog
# e.g. point at an external drive later for large vendor datasets:
# CATALOG_PATH=/Volumes/Seagate/bagel/catalog
USE_RTH=true
BAGEL_CAPITAL=1000000
