FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS builder
ARG POETRY_VERSION=2.3.4
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 POETRY_NO_INTERACTION=1 POETRY_VIRTUALENVS_IN_PROJECT=true
WORKDIR /app
RUN pip install --no-cache-dir "poetry==$POETRY_VERSION" && python -m venv .venv
COPY pyproject.toml poetry.lock poetry.toml ./
RUN poetry install --only main --no-root
COPY README.md ./
COPY api ./api
COPY market ./market
RUN poetry install --only main

FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS runtime
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
RUN groupadd --gid 10001 bagel && useradd --uid 10001 --gid bagel --no-create-home bagel \
    && install -d -m 0700 -o 10001 -g 10001 /app/research
COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv
COPY --chown=10001:10001 api ./api
COPY --chown=10001:10001 market ./market
COPY --chown=10001:10001 tools ./tools
COPY --chown=10001:10001 database/ddl ./database/ddl
USER 10001:10001

# Preserve the existing collector image contract without changing hosted runtimes.
FROM runtime AS collector
EXPOSE 9090
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD python -c \
    "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.getenv('BAGEL_HEALTH_PORT','9090')+'/health/live',timeout=3)"
ENTRYPOINT ["bagel-market-data"]
CMD ["run"]

FROM runtime AS api
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD python -c \
    "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health/ready',timeout=3)"
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8001"]
